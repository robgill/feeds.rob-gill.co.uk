# Database.
# Leave both unset to use the local PGlite database in data/pglite.
# On Vercel, the Neon integration sets DATABASE_URL and usually POSTGRES_URL.
# The running app uses DATABASE_URL when it is set, otherwise POSTGRES_URL.
# For `npm run db:setup`, pass the unpooled (direct) URL. The pooled URL is for the app.
# Do not commit a real connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Bearer token for GET /api/cron.
# Send Authorization: Bearer <this value>. Vercel Cron does that when this is set.
# Use a long random string. The route refuses to run until this is set.
# CRON_SECRET=

# Slack incoming webhook. The Slack destination in feeds.config.ts names this
# variable (webhookUrlEnv). The URL is never stored in the database and never
# shown on the status page.
# SLACK_FEEDS_WEBHOOK_URL=

# Address named by the email destination (toEnv). Email is not sent yet.
# The status page shows the destination name, not this address.
# FEEDS_EMAIL_TO=

# Owner written by `npm run db:setup`. When set, these override owner in
# feeds.config.ts. Leave them unset to use the name and email in that file.
# They are read by the setup script, not by the status page.
# OWNER_NAME=
# OWNER_EMAIL=

# Brand. Unset, or any value other than robgill, uses the plain local theme.
# Set robgill to load https://rob-gill.co.uk/brand.js and brand.css, the head
# bitmap that links to rob-gill.co.uk, and that site's share card and icons.
# Next.js reads NEXT_PUBLIC_ variables at build time. Set it, then redeploy
# (or restart `npm run dev`).
# NEXT_PUBLIC_BRAND=robgill
