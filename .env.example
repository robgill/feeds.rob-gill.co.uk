# Leave DATABASE_URL unset to use the local PGlite database in data/pglite.
# Set it to a Neon or Vercel Postgres connection string to use that instead.
# Use a direct (non-pooled) URL for npm run db:setup.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Required before /api/cron will run. Send Authorization: Bearer <this value>.
# Vercel Cron sends that header when CRON_SECRET is set on the project.
# CRON_SECRET=

# Named by the seeded destination config. Nothing reads them until a later
# milestone sends to Slack and email. Do not put the secret values in the database.
# SLACK_FEEDS_WEBHOOK_URL=
# FEEDS_EMAIL_TO=
