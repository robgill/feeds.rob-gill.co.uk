  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
